{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["import", "node", "oxc", "promise", "promise", "typescript", "unicorn", "vitest"],
  "categories": {
    "correctness": "error",
  },
  "options": {
    "typeAware": true,
    "typeCheck": true,
  },
  "rules": {},
  "env": {
    "builtin": true,
  },
}
